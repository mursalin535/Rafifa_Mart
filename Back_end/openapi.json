{
  "openapi": "3.0.3",
  "info": {
    "title": "Rafifa Mart API",
    "version": "1.0.0",
    "description": "REST API for the Rafifa Mart perfume & attar e-commerce platform (subset of endpoints)."
  },
  "servers": [{ "url": "http://localhost:5007", "description": "Local development" }],
  "tags": [
    { "name": "Auth" },
    { "name": "Products" },
    { "name": "Orders" }
  ],
  "components": {
    "securitySchemes": {
      "cookieAuth": { "type": "apiKey", "in": "cookie", "name": "rafifa_session" }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "message": { "type": "string" }
        }
      },
      "OrderItem": {
        "type": "object",
        "required": ["variant_id", "quantity"],
        "properties": {
          "variant_id": { "type": "integer", "example": 3 },
          "quantity": { "type": "integer", "minimum": 1, "example": 2 }
        }
      }
    }
  },
  "paths": {
    "/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Customer login with email and password",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "example": "user@example.com" },
                  "password": { "type": "string", "example": "Secret@123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Logged in; session cookie set" },
          "400": { "description": "Missing email or password" },
          "401": { "description": "Invalid email or password" },
          "403": { "description": "Account not active" },
          "429": { "description": "Too many login attempts" }
        }
      }
    },
    "/products": {
      "get": {
        "tags": ["Products"],
        "summary": "List all perfumes with price range and stock",
        "responses": { "200": { "description": "List of products" } }
      }
    },
    "/product/{id}": {
      "get": {
        "tags": ["Products"],
        "summary": "Get one perfume with its variants",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Product with variants" },
          "404": { "description": "Product not found" }
        }
      }
    },
    "/add_order": {
      "post": {
        "tags": ["Orders"],
        "summary": "Place a perfume order (Cash on Delivery)",
        "description": "Price is always calculated by the server using active offers. If expected_total differs from the server total, the order is rejected with PRICE_CHANGED.",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["address_id", "items"],
                "properties": {
                  "address_id": { "type": "integer", "example": 1 },
                  "payment_method": { "type": "string", "enum": ["cod"], "default": "cod" },
                  "expected_total": { "type": "number", "example": 1800 },
                  "items": { "type": "array", "items": { "$ref": "#/components/schemas/OrderItem" } }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Order placed" },
          "400": { "description": "Invalid input", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "401": { "description": "Login required" },
          "404": { "description": "Address or variant not found" },
          "409": { "description": "Insufficient stock or price changed" }
        }
      }
    },
    "/orders": {
      "get": {
        "tags": ["Orders"],
        "summary": "List all orders (admin only)",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": { "description": "List of orders" },
          "401": { "description": "Admin authentication required" }
        }
      }
    },
    "/update_order_status/{id}": {
      "put": {
        "tags": ["Orders"],
        "summary": "Change an order's status (admin only)",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["status"],
                "properties": {
                  "status": { "type": "string", "enum": ["pending", "confirmed", "shipped", "delivered", "rejected"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Status updated" },
          "400": { "description": "Invalid status" },
          "401": { "description": "Admin authentication required" },
          "404": { "description": "Order not found" }
        }
      }
    }
  }
}
